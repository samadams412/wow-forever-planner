# Build tracking (anonymous build share/save/open counts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret used to key-hash visitor tokens and IPs. Any long random string.
BUILD_TRACKING_SECRET=
# Bearer token Vercel Cron sends to /api/cron/build-rollup. Set in Vercel; any long random string locally.
CRON_SECRET=
# Local and `next dev` servers never write to Redis (the pulled .env.local points
# at the production database). Set to 1 only to test tracking end to end locally.
BUILD_TRACKING_ALLOW_LOCAL=
