xtSource":"foreverchanges","classicXp":2200,"classRestriction":null,"difficultyBands":[{"color":"red","level":10},{"color":"orange","level":18},{"color":"yellow","level":20},{"color":"green","level":25},{"color":"grey","level":29}],"repeatable":false,"timelimit":null,"profession":null,"shareable":"Yes","status":"changed","statusNote":"Changed in Forever. Requires level 10 instead of 11. Gives 4,300 experience instead of 2,200, 1.95 times as much. New rewards: Hammerbone. Read from what the game server sent in the beta. Its experience counts the level 30 build, which halved what dungeon quests give beyond a normal quest.","footerSourceNote":"Text, givers, objectives and rewards come from the cMaNGOS Classic database (a reconstruction of the 1.12 world), with what Forever changed on top: the game server’s own answers where we have them, else Wowhead’s Forever database. Places are Classic’s, shown on the Forever maps. Quest text © Blizzard Entertainment.","narrative":{"details":"The druids in the Wailing Caverns, the Druids of the Fang, are an aberration.  They were part of an order of noble druids whose plan was to heal the Barrens, but now seek to remake that land to match their own, twisted dreams.\n\nThe Druids of the Fang have four leaders, and each possesses a dream gem.  Even now their faces haunt me!  Defeat the leaders and bring me their gems, and the Barrens may again know peace.\n\nGo, adventurer.  You will find them lurking deep within the Wailing Caverns.","objectives":"Bring the Gems of Cobrahn, Anacondra, Pythas and Serpentis to Nara Wildmane in Thunder Bluff.","offerRewardText":"You have done it, adventurer. You killed the leaders of the Druids of the Fang. My dreams are now free of their wicked faces, and you have helped save the Barrens from a cursed future.I thank you, adventurer. I thank you for myself, for the druids of Thunder Bluff, and for the land.","requestItemsText":"Memories of my nightmares haunt me, adventurer. Have you defeated the leaders of the fang and acquired their gems?","endText":null,"objectiveText":[]},"narrativeSource":"foreverchanges","prevQuest":{"id":1490,"name":"Nara Wildmane"},"nextQuest":null,"nextQuestInChain":null,"giverName":"Nara Wildmane","turnInName":"Nara Wildmane","startItemText":null,"startNpcs":[{"name":"Nara Wildmane","zone":"Thunder Bluff","x":75.6,"y":31.6}],"endNpcs":[{"name":"Nara Wildmane","zone":"Thunder Bluff","x":75.6,"y":31.6}],"reputation":[{"faction":"Thunder Bluff","factionId":null,"amount":150}],"mentionedItems":[],"mapGroups":[{"zoneId":1638,"zoneName":"Thunder Bluff","continent":"kalimdor","imageUrl":"/images/zone-maps/1638.jpg","markers":[{"kind":"start","npcName":"Nara Wildmane","xPct":75.6,"yPct":31.6},{"kind":"end","npcName":"Nara Wildmane","xPct":75.6,"yPct":31.6}]}],"chain":{"subtitle":"7 quests from level 10 to 22, 7,770 XP in all.","steps":[{"stepNumber":1,"isCurrentStep":false,"quests":[{"questId":886,"name":"The Barrens Oases","isCurrent":false,"level":"10","objectiveText":"Speak with Tonga Runetotem at the Crossroads.","giverName":"Arch Druid Hamuul Runetotem","giverZone":"Thunder Bluff","xpText":"85 XP","rewardItem":{"itemId":null,"href":null,"icon":"","name":null,"quality":null,"qty":1},"variants":null}]},{"stepNumber":2,"isCurrentStep":false,"quests":[{"questId":870,"name":"The Forgotten Pools","isCurrent":false,"level":"13","objectiveText":"Report back to Tonga Runetotem with your findings.","giverName":"Tonga Runetotem","giverZone":"The Barrens","xpText":"675 XP","rewardItem":{"itemId":null,"href":null,"icon":"","name":null,"quality":null,"qty":1},"variants":null}]},{"stepNumber":3,"isCurrentStep":false,"quests":[{"questId":877,"name":"The Stagnant Oasis","isCurrent":false,"level":"16","objectiveText":"Return to Tonga at The Crossroads, after investigating the Stagnant Oasis.","giverName":"Tonga Runetotem","giverZone":"The Barrens","xpText":"1,150 XP","rewardItem":{"itemId":null,"href":null,"icon":"","name":null,"quality":null,"qty":1},"varia